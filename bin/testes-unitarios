#!/usr/bin/env bash
# Testes unitários das gems haystack e haystack-rails.
#
#   bin/testes-unitarios                 com o Ruby da máquina (Rails 6.1)
#   bin/testes-unitarios --ruby 2.6.4    em Docker, com outro Ruby (Rails 5.2 no 2.x, 6.1 no 3.x)
#   bin/testes-unitarios --rails 7.1     outra versão do Rails para o haystack-rails
#
# Em Docker, os testes de Redis (precisam de um servidor Redis) e o de release
# pelo git (o .git não é copiado) falham por falta do ambiente, não da gem.
set -uo pipefail

RAIZ="$(cd "$(dirname "$0")/.." && pwd)"
RUBY_DOCKER=""
RAILS=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ruby) RUBY_DOCKER="$2"; shift 2 ;;
    --rails) RAILS="$2"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "opção desconhecida: $1" >&2; exit 2 ;;
  esac
done

if [[ -z "$RUBY_DOCKER" ]]; then
  RAILS="${RAILS:-6.1}"
  falhou=0
  echo "== haystack (núcleo)"
  (cd "$RAIZ/haystack" && (bundle check >/dev/null || bundle install --quiet) && bundle exec rake spec) || falhou=1
  echo "== haystack (isolados: Puma etc.)"
  (cd "$RAIZ/haystack" && bundle exec rake isolated_specs) || falhou=1
  echo "== haystack-rails (Rails $RAILS)"
  (cd "$RAIZ/haystack-rails" && export RAILS_VERSION="$RAILS" && (bundle check >/dev/null || bundle install --quiet) && bundle exec rspec) || falhou=1
  exit $falhou
fi

# Em Docker: copia o repositório para dentro do container (o Bundler precisa
# escrever o Gemfile.lock) e guarda as gems num volume por versão do Ruby
case "$RUBY_DOCKER" in
  2.*) RAILS="${RAILS:-5.2}"; RACK="2.2" ;;
  *) RAILS="${RAILS:-6.1}"; RACK="3.0" ;;
esac

exec docker run --rm \
  -e RAILS_VERSION="$RAILS" -e RACK_VERSION="$RACK" \
  -e BUNDLE_FORCE_RUBY_PLATFORM=true -e BUNDLE_WITHOUT=rubocop \
  -v "$RAIZ":/src:ro -v "haystack-unitarios-$RUBY_DOCKER":/usr/local/bundle \
  "ruby:$RUBY_DOCKER" bash -c '
    mkdir -p /work && cd /src
    tar --exclude=./integration --exclude=./.git --exclude="*/coverage" -cf - . | tar -xf - -C /work
    rm -f /work/Gemfile.lock /work/*/Gemfile.lock
    falhou=0
    echo "== haystack (núcleo), Ruby $(ruby -e "print RUBY_VERSION")"
    (cd /work/haystack && bundle install --quiet && bundle exec rake spec) || falhou=1
    echo "== haystack (isolados)"
    (cd /work/haystack && bundle exec rake isolated_specs) || falhou=1
    echo "== haystack-rails (Rails $RAILS_VERSION)"
    (cd /work/haystack-rails && bundle install --quiet && bundle exec rspec) || falhou=1
    exit $falhou'
