require "haystack/deploy_marker"

namespace :haystack do
  desc "Registra o deploy no Haystack (marcadores nos gráficos e revisão no ar)"
  task :deploy do
    result = Haystack::DeployMarker.notify(
      dsn: fetch(:haystack_dsn, ENV["HAYSTACK_DSN"]),
      revision: fetch(:haystack_revision, fetch(:current_revision)),
      user: fetch(:haystack_user, ENV["USER"] || ENV["USERNAME"]),
      markers_url: fetch(:haystack_markers_url, nil)
    )

    if result.ok?
      puts "[haystack] #{result.message}"
    else
      warn "[haystack] #{result.message}"
    end
  end
end

# Como no Haystack 0.x: basta o `require 'haystack/capistrano'` no deploy.rb para
# registrar todo deploy (os apps antigos não declaram o hook). Se o app também
# chamar a task em outro momento, o Rake só a executa uma vez por deploy.
after "deploy:finished", "haystack:deploy" if respond_to?(:after, true)
